<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP sin cifrar solo hacia la propia máquina: el visor 3D
     (model_viewer_plus) usa un servidor local, y 10.0.2.2 es la
     computadora vista desde el emulador (servidor de desarrollo).
     El servidor desplegado debe usar HTTPS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
